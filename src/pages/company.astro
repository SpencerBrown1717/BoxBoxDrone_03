---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Catalog from '../components/Catalog.astro';
import SectionHead from '../components/SectionHead.astro';
import Statement from '../components/Statement.astro';
import Roadmap from '../components/Roadmap.astro';
import CtaBand from '../components/CtaBand.astro';
import Logo from '../components/Logo.astro';
import { company as copy } from '../content/pages';
import { site } from '../config/site';
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead} layout="split">
    <Fragment slot="actions">
      <Button href="/contact" size="lg">Talk to us</Button>
      <Button href="/why-now" variant="secondary" size="lg">Why now</Button>
    </Fragment>
    <div slot="side" class="mark-plate" aria-hidden="true">
      <Logo size={128} />
    </div>
  </PageHero>

  <section class="section section--rule">
    <div class="frame stack-lg">
      <SectionHead title="What we build" />
      <Catalog items={copy.pillars} />
    </div>
  </section>

  <section class="section section--deep">
    <div class="frame">
      <Statement title={copy.beliefs.title} text={copy.beliefs.text} facts={copy.beliefs.items} note={`${site.legalName} is based in ${site.locality}, ${site.region}.`} />
    </div>
  </section>

  <Roadmap id="roadmap" />

  <CtaBand title={copy.cta.title} text={copy.cta.text}>
    <Button href="/contact" size="lg">Talk to us</Button>
  </CtaBand>
</Base>

<style>
  .mark-plate {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    width: 100%;
    color: var(--color-white);
    background: var(--glass), var(--color-graphite);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-surface);
  }
</style>
