---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsIndex from '../../components/NewsIndex.astro';
import StoryCard from '../../components/StoryCard.astro';
import MiniScene from '../../components/MiniScene.astro';
import { categories, categoryLabel, categoryScene, formatDate, getStories, isoDate, readingMinutes, type Category, type Story } from '../../lib/news';

export async function getStaticPaths() {
  const stories = await getStories();
  const clash = stories.find((story) => categories.some((c) => c.id === story.id));
  if (clash) throw new Error(`News story "${clash.id}" uses a section name as its slug. Rename the file.`);
  return [
    ...stories.map((story) => ({ params: { slug: story.id }, props: { kind: 'story' as const, story } })),
    ...categories.map((c) => ({ params: { slug: c.id }, props: { kind: 'category' as const, category: c.id } })),
  ];
}

type Props = { kind: 'story'; story: Story } | { kind: 'category'; category: Category };
const props = Astro.props as Props;

let Content: any = null;
let related: Story[] = [];
if (props.kind === 'story') {
  ({ Content } = await render(props.story));
  const all = await getStories();
  related = all.filter((s) => s.id !== props.story.id).slice(0, 3);
}
---

{
  props.kind === 'category' ? (
    <Base
      title={`${categoryLabel(props.category)} | BoxBox Drone Newsroom`}
      description={categories.find((c) => c.id === props.category)?.description}
    >
      <NewsIndex category={props.category} />
    </Base>
  ) : (
    <Base title={`${props.story.data.title} | BoxBox Drone`} description={props.story.data.dek}>
      <article class="article">
        <header class="article-head">
          <p class="article-back">
            <a href="/news">Newsroom</a>
            <span aria-hidden="true">/</span>
            <a href={`/news/${props.story.data.category}`}>{categoryLabel(props.story.data.category)}</a>
          </p>
          <h1 class="article-title">{props.story.data.title}</h1>
          <p class="article-dek">{props.story.data.dek}</p>
          <p class="article-meta">
            <time datetime={isoDate(props.story.data.date)}>{formatDate(props.story.data.date)}</time>
            <span>{readingMinutes(props.story.body)} minute read</span>
            <span>BoxBox Drone Newsroom</span>
          </p>
        </header>

        <figure class="article-plate" aria-hidden="true">
          <MiniScene scene={categoryScene[props.story.data.category]} />
        </figure>

        <div class="article-body prose">
          <Content />
        </div>

        <aside class="article-sources" aria-labelledby="sources-title">
          <h2 id="sources-title">Sources</h2>
          <ol>
            {props.story.data.sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener">
                  {source.title}
                </a>
                <span>
                  {source.publisher}
                  {source.date ? `, ${source.date}` : ''}
                </span>
              </li>
            ))}
          </ol>
          <p class="article-note">
            Written by BoxBox Drone from these sources. BoxBox Drone is not affiliated with the organizations in this story unless it says so.
          </p>
        </aside>
      </article>

      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <div class="related-inner">
            <h2 class="related-title" id="related-title">
              More from the newsroom
            </h2>
            <div class="related-grid">
              {related.map((story) => (
                <StoryCard story={story} />
              ))}
            </div>
          </div>
        </section>
      )}
    </Base>
  )
}

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: var(--max);
    margin-inline: auto;
    padding: calc(var(--nav-h) + clamp(48px, 8vw, 104px)) var(--margin) 0;
  }

  .article-head {
    max-width: 52rem;
  }

  .article-plate {
    margin: 40px 0 0;
    padding: 24px;
    background: var(--color-graphite);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-surface);
  }

  .article-plate :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 599px) {
    .article-plate {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .article {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      column-gap: clamp(48px, 6vw, 112px);
    }

    .article-head {
      grid-column: 1;
      grid-row: 1;
    }

    .article-plate {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      margin: 0;
    }

    .article-body {
      grid-column: 1;
      grid-row: 2;
    }

    .article-sources {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      position: sticky;
      top: calc(var(--nav-h) + 32px);
    }
  }

  .article-back {
    display: flex;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--color-pumice);
  }

  .article-back a {
    color: var(--amethyst-hot);
    text-decoration: none;
  }

  .article-back a:hover {
    text-decoration: underline;
  }

  .article-title {
    margin-top: 22px;
    font-size: clamp(2.6rem, 1.7rem + 3.6vw, 5.25rem);
    line-height: 0.98;
  }

  .article-dek {
    margin-top: 24px;
    max-width: 46ch;
    font-size: clamp(1.1875rem, 1.06rem + 0.5vw, 1.5rem);
    line-height: 1.45;
    color: rgb(232 230 225 / 0.82);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 28px;
    padding-bottom: 28px;
    font-size: 0.875rem;
    color: var(--color-pumice);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .article-body {
    margin-top: 40px;
  }

  .article-sources {
    max-width: 68ch;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--hairline-strong);
  }

  @media (min-width: 1100px) {
    .article-sources {
      margin-top: 40px;
      padding-top: 20px;
    }
  }

  .article-sources h2 {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .article-sources ol {
    display: grid;
    gap: 12px;
    margin: 16px 0 0;
    padding-left: 1.25rem;
    color: var(--color-pumice);
  }

  .article-sources li {
    padding-left: 4px;
    font-size: 0.9375rem;
  }

  .article-sources a {
    color: var(--amethyst-hot);
    text-decoration: underline;
    text-decoration-color: rgb(var(--amethyst-hot-rgb) / 0.4);
    text-underline-offset: 0.2em;
  }

  .article-sources li span {
    display: block;
    font-size: 0.8125rem;
  }

  .article-note {
    margin-top: 24px;
    font-size: 0.8125rem;
    color: var(--color-pumice);
  }

  .related {
    margin-top: clamp(96px, 12vw, 160px);
    padding-block: clamp(72px, 9vw, 120px);
    border-top: 1px solid var(--hairline);
  }

  .related-inner {
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .related-title {
    font-size: var(--t-title);
  }

  .related-grid {
    display: grid;
    gap: 44px;
    margin-top: 40px;
  }

  @media (min-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gutter);
    }
  }
</style>
