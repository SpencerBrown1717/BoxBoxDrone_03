---
import Base from '../layouts/Base.astro';

// A flight path that wanders off course and ends where the link was lost.
const width = 800;
const height = 140;
let d = `M 0 ${height - 20}`;
let x = 0;
let y = height - 20;
for (let i = 1; i <= 60; i++) {
  x = (i / 60) * width * 0.86;
  y = height - 20 - 70 * Math.sin((i / 60) * Math.PI * 0.9) + 14 * Math.sin(i * 0.9) * (i / 60);
  d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
}
const endX = x;
const endY = y;
---

<Base title="Lost link | BoxBox Drone" description="There's no page at this address." noindex>
  <section class="lost">
    <div class="lost-inner">
      <svg class="trace" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d={d} pathLength="1"></path>
        <path class="lost-end" d={`M ${endX.toFixed(1)} ${endY.toFixed(1)} h 0`}></path>
      </svg>
      <h1 class="lost-title">Lost link.</h1>
      <p class="lost-support">There's no page at this address. Check the link, or fly back to the home page.</p>
      <a class="lost-back button button--secondary" href="/">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: calc(var(--nav-h) + 48px) 96px;
  }

  .lost-inner {
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .trace {
    display: block;
    width: 100%;
    height: clamp(90px, 16vw, 140px);
    margin-bottom: 48px;
    overflow: visible;
  }

  .trace path {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 1.5;
    stroke-dasharray: 0.006 0.012;
    vector-effect: non-scaling-stroke;
  }

  .trace .lost-end {
    stroke: var(--color-amber);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lost-end {
      animation: blink 1.4s ease-in-out infinite;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }

  .lost-title {
    font-size: var(--t-display);
  }

  .lost-support {
    margin-top: 18px;
    max-width: 40ch;
    font-size: var(--t-lead);
    color: rgb(232 230 225 / 0.78);
  }

  .lost-back {
    margin-top: 32px;
  }
</style>
