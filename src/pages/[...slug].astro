---
/** One page per topic: industries, technologies and products. */
import TopicPage from '../layouts/TopicPage.astro';
import { topics } from '../content/topics';
import type { Topic } from '../content/topics/types';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
---

<TopicPage topic={topic} />
