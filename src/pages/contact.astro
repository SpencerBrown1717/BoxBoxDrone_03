---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { contact as copy } from '../content/pages';
import { site } from '../config/site';

const mailto = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead}>
    <p slot="actions" class="direct">
      Or write to <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </PageHero>

  <section class="section section--rule topics-section" aria-label="What to talk about">
    <div class="frame">
      <ul class="topics" data-topics>
        {
          copy.topics.map((topic) => (
            <li class="topic" id={`topic-${topic.id}`} data-topic={topic.id}>
              <span class="topic-icon">
                <Icon name={topic.icon} size={24} />
              </span>
              <span class="topic-body">
                <span class="topic-title">{topic.title}</span>
                <span class="topic-text">{topic.text}</span>
              </span>
              <a class="topic-link button button--secondary button--sm" href={mailto(topic.subject)}>
                {copy.action}
                <span class="visually-hidden"> about {topic.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  // Pages link here with ?topic=drako and so on: mark that topic and bring it into view.
  const topic = new URLSearchParams(location.search).get('topic');
  const row = topic ? document.querySelector<HTMLElement>(`[data-topic="${CSS.escape(topic)}"]`) : null;
  if (row) {
    row.classList.add('is-picked');
    const link = row.querySelector<HTMLAnchorElement>('a');
    link?.classList.replace('button--secondary', 'button--primary');
    row.scrollIntoView({ block: 'center' });
  }
</script>

<style>
  .direct {
    font-size: var(--t-lead);
    color: rgb(232 230 225 / 0.8);
  }

  .topics-section {
    padding-top: 0;
    border-top: 0;
  }

  .topics {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline-strong);
  }

  .topic {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px 20px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  @media (min-width: 720px) {
    .topic {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }

  .topic-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--color-glacier);
    background: var(--night-raised);
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
  }

  .topic-body {
    display: grid;
    gap: 4px;
  }

  .topic-title {
    font-weight: 500;
    font-size: 1.1875rem;
    color: var(--color-ash);
  }

  .topic-text {
    font-size: 1rem;
    color: rgb(232 230 225 / 0.7);
  }

  .topic-link {
    grid-column: 2;
    justify-self: start;
  }

  @media (min-width: 720px) {
    .topic-link {
      grid-column: 3;
    }
  }

  .topic:global(.is-picked) {
    border-bottom-color: var(--hairline-strong);
  }

  .topic:global(.is-picked) .topic-icon {
    border-color: var(--color-glacier);
  }
</style>
