---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icon-paths';
import { contact as copy } from '../content/pages';
import { site, mailto } from '../config/site';

const icons: Record<string, IconName> = {
  delivery: 'package',
  drako: 'flag',
  shows: 'sparkle',
  engineering: 'model',
  press: 'message',
};
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} lead={copy.hero.lead}>
    <Button slot="actions" href={mailto()} size="lg">Email {site.email}</Button>
  </PageHero>

  <section class="section section--rule" aria-label="Topics">
    <div class="frame">
      <ul class="topics">
        {
          copy.topics.map((topic) => (
            <li class="topic" id={topic.id}>
              <span class="topic-icon">
                <Icon name={icons[topic.id] ?? 'message'} size={24} />
              </span>
              <span class="topic-body">
                <span class="topic-title">{topic.title}</span>
                <span class="topic-text">{topic.text}</span>
              </span>
              <a class="topic-link button button--secondary button--sm" href={mailto(topic.subject)}>
                Write to us
                <span class="visually-hidden"> about {topic.title.toLowerCase()}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="direct">
        {copy.direct} <a class="text-link" href={mailto()}>{site.email}</a>. We’re in {site.locality}, {site.region}.
      </p>
    </div>
  </section>
</Base>

<style>
  .topics {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .topic {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px 20px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .topic:target {
    background: linear-gradient(90deg, rgb(var(--amber-rgb) / 0.08), transparent 60%);
  }

  @media (min-width: 760px) {
    .topic {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }

  .topic-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--color-glacier);
    background: var(--night-raised);
    border: 1px solid var(--hairline-strong);
    border-radius: 10px;
  }

  .topic-body {
    display: grid;
    gap: 4px;
  }

  .topic-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
    line-height: 1.05;
  }

  .topic-text {
    color: rgb(232 230 225 / 0.74);
  }

  .topic-link {
    grid-column: 2;
    justify-self: start;
  }

  @media (min-width: 760px) {
    .topic-link {
      grid-column: 3;
    }
  }

  .direct {
    margin-top: 40px;
    color: rgb(232 230 225 / 0.8);
  }
</style>
