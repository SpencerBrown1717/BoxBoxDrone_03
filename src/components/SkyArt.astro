---
/**
 * The hero's lit world: a plane of drones seen in perspective, receding to the
 * horizon where the cost line lands. The same geometry the sky canvas draws, as a
 * still, so the hand-off from hero to sky is seamless. Decorative only.
 */
const W = 1600;
const H = 720;
const Z_NEAR = 1;
const Z_FAR = 10;
const COUNT = 640;

function mulberry32(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(11);
const buckets = [
  { max: 1.8, width: 3, opacity: 0.6, d: '' },
  { max: 3, width: 2.4, opacity: 0.5, d: '' },
  { max: 5.5, width: 1.8, opacity: 0.42, d: '' },
  { max: Z_FAR, width: 1.4, opacity: 0.34, d: '' },
];
const f = (v: number) => v.toFixed(1);

for (let i = 0; i < COUNT; i++) {
  const z = Z_NEAR + (Z_FAR - Z_NEAR) * ((i + rand() * 0.9) / COUNT);
  const px = (rand() * 2 - 1) * z * 1.02;
  const alt = 0.06 + 0.94 * Math.pow(rand(), 0.85);
  const x = W / 2 + (px * W * 0.56) / z;
  const y = H - (H * 0.97 * alt) / z;
  if (x < 2 || x > W - 2 || z < 1.15) continue;
  const bucket = buckets.find((b) => z <= b.max) ?? buckets[buckets.length - 1];
  bucket.d += `M${f(x)} ${f(y)}h0`;
}
---

<svg class="sky-art" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  {buckets.map((b) => <path d={b.d} stroke-width={b.width} opacity={b.opacity} />)}
</svg>

<style>
  .sky-art {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sky-art path {
    fill: none;
    stroke: var(--color-glacier);
    stroke-linecap: square;
  }
</style>
