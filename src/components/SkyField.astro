---
/**
 * The canvas for the sky above the horizon. Drawn by scripts/sky.ts,
 * orchestrated by scripts/story.ts. Hidden from assistive technology: the
 * scenes tell the same story in text.
 */
---

<div class="sky" data-sky>
  <canvas class="sky-canvas" data-sky-canvas aria-hidden="true"></canvas>
</div>

<style>
  .sky {
    position: sticky;
    top: 0;
    order: 1;
    height: 100svh;
    z-index: 0;
  }

  :global(.motion-ok) .sky {
    position: absolute;
    inset: 0;
    height: auto;
    opacity: 0;
  }

  .sky-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
