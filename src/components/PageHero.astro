---
/**
 * Inner page hero: label, headline, lead and actions. A visual can follow
 * (slot "visual") or sit beside the copy (layout="split").
 */
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  layout?: 'stack' | 'split';
}

const { eyebrow, title, lead, layout = 'stack' } = Astro.props;
---

<section class:list={['page-hero', `page-hero--${layout}`]}>
  <div class="page-hero-inner">
    <div class="page-hero-copy">
      <p class="page-hero-eyebrow">{eyebrow}</p>
      <h1 class="page-hero-title">{title}</h1>
      <p class="page-hero-lead">{lead}</p>
      <div class="page-hero-actions"><slot name="actions" /></div>
    </div>
    {layout === 'split' && <div class="page-hero-side"><slot name="side" /></div>}
  </div>
  <slot name="visual" />
</section>

<style>
  .page-hero {
    padding-top: calc(var(--nav-h) + clamp(56px, 9vw, 120px));
  }

  .page-hero-inner {
    display: grid;
    gap: 48px;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--margin);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .page-hero--split .page-hero-inner {
    align-items: center;
  }

  @media (min-width: 960px) {
    .page-hero--split .page-hero-inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 64px;
    }
  }

  .page-hero-eyebrow {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-amber);
  }

  .page-hero-title {
    margin-top: 18px;
    font-size: clamp(3.1rem, 1.9rem + 5.6vw, 8rem);
    line-height: 0.94;
    letter-spacing: -0.014em;
    max-width: 10em;
  }

  .page-hero-lead {
    margin-top: 26px;
    max-width: 40ch;
    font-size: clamp(1.125rem, 1.02rem + 0.45vw, 1.4375rem);
    line-height: 1.5;
    color: rgb(232 230 225 / 0.8);
  }

  .page-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .page-hero-actions:empty {
    display: none;
  }
</style>
