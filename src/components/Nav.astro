---
/**
 * Primary navigation. One tree at every size:
 * - Wide: two menus open full-width mega panels (native popovers), with hover preview.
 * - Narrow: a drawer, where each menu is a disclosure listing its pages.
 * Without script, the drawer shows every link expanded.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MiniScene from './MiniScene.astro';
import Button from './Button.astro';
import { tabs, links } from '../content/nav';
import { topics } from '../content/topics';
import { site } from '../config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

// The menu a page belongs to: its hub, or the section of its topic
const slug = path.slice(1);
const section = topics.find((topic) => topic.slug === slug)?.section ?? slug;
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <Logo size={22} class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <button
        class="menu-button button button--secondary button--sm"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu"
      >
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M2 6h14M2 12h14" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <span>Menu</span>
      </button>

      <ul id="site-menu" class="site-menu" popover="auto">
        {
          tabs.map((tab) => {
            return (
              <li class:list={['nav-item', section === tab.id && 'is-current']} data-mega-item>
                <button
                  class="tab"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`mega-${tab.id}`}
                  popovertarget={`mega-${tab.id}`}
                  data-mega-trigger
                >
                  <span>{tab.label}</span>
                  <Icon name="chevron" size={14} class="tab-chevron" />
                </button>

                <div class="mega" id={`mega-${tab.id}`} data-mega>
                  <div class="mega-scroll">
                    <div class="mega-body">
                      <div class="mega-intro">
                        <p class="mega-headline">{tab.headline}</p>
                        <p class="mega-description">{tab.description}</p>
                        <a class="mega-all" href={tab.href}>
                          {tab.allLabel}
                        </a>
                        <div class="mega-scene">
                          <MiniScene scene={tab.scene} />
                        </div>
                      </div>

                      <div class="mega-primary">
                        <ul class:list={['mega-grid', tab.items.length % 2 === 1 && 'mega-grid--single']}>
                          {tab.items.map((item) => (
                            <li>
                              <a class="mega-link" href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                                <span class="mega-icon">
                                  <Icon name={item.icon} />
                                </span>
                                <span class="mega-text">
                                  <span class="mega-title">{item.title}</span>
                                  <span class="mega-desc">{item.description}</span>
                                </span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <div class="mega-secondary">
                        {tab.groups.map((group) => (
                          <div class="mega-section">
                            <p class="mega-group">{group.title}</p>
                            <ul class="mega-sublist">
                              {group.links.map((link) => (
                                <li>
                                  <a class="mega-sublink" href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                                    <Icon name={link.icon} size={18} class="mega-subicon" />
                                    {link.title}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                  <div class="mega-foot">
                    <p>{tab.note}</p>
                    <a href={tab.cta.href}>{tab.cta.label}</a>
                  </div>
                </div>
              </li>
            );
          })
        }
        {
          links.map((link) => (
            <li class="nav-item">
              <a class="tab tab-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="menu-cta">
          <Button href={site.contactUrl} size="lg" data-cta="menu">Talk to us</Button>
        </li>
      </ul>
    </nav>

    <Button href={site.contactUrl} size="sm" class="nav-cta" data-cta="nav">Talk to us</Button>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    background: rgb(var(--obsidian-rgb) / 0.9);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  /* Keep the row's natural width measurable */
  .header-inner > * {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-white);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
  }

  .site-nav {
    margin-inline-start: auto;
  }

  .menu-button {
    gap: 8px;
    anchor-name: --menu-button;
  }

  .nav-cta {
    margin-inline-start: 4px;
  }

  /* ---------- Narrow: a drawer under the header ---------- */

  .site-menu {
    position: fixed;
    inset: auto;
    top: var(--nav-h);
    left: 0;
    right: 0;
    width: 100%;
    height: calc(100dvh - var(--nav-h));
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 8px var(--margin) calc(32px + env(safe-area-inset-bottom));
    overflow: auto;
    list-style: none;
    color: var(--color-ash);
    background: var(--color-obsidian);
    border: 0;
    border-top: 1px solid var(--hairline);
  }

  .nav-item {
    border-bottom: 1px solid var(--hairline);
  }

  .tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 18px 0;
    color: var(--color-ash);
    background: none;
    border: 0;
    font-family: var(--font-display);
    font-size: 1.875rem;
    line-height: 1.1;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .tab-chevron {
    flex: none;
    color: var(--color-pumice);
    transition: rotate 0.2s var(--ease-out);
  }

  .tab[aria-expanded='true'] .tab-chevron {
    rotate: 180deg;
  }

  .mega {
    padding: 0 0 20px;
    white-space: normal;
  }

  .mega[hidden] {
    display: none;
  }

  .mega-headline,
  .mega-description,
  .mega-scene,
  .mega-story,
  .mega-foot {
    display: none;
  }

  .mega-all {
    display: inline-block;
    margin-bottom: 14px;
    color: var(--amethyst-hot);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-color: rgb(var(--amethyst-hot-rgb) / 0.4);
  }

  .mega-group {
    margin: 14px 0 6px;
    font-size: var(--t-micro);
    color: var(--color-pumice);
  }

  .mega-grid,
  .mega-sublist {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega-link {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 10px 0;
    color: inherit;
    text-decoration: none;
  }

  .mega-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    color: var(--color-glacier);
    background: var(--night-raised);
    border: 1px solid var(--hairline-strong);
    border-radius: 10px;
  }

  .mega-text {
    display: grid;
    gap: 2px;
    padding-top: 1px;
  }

  .mega-title {
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-ash);
  }

  .mega-desc {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-pumice);
  }

  .mega-link[aria-current='page'] .mega-title,
  .mega-sublink[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: rgb(232 230 225 / 0.45);
  }

  .mega-section + .mega-section {
    margin-top: 6px;
  }

  .mega-sublink {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    color: var(--color-ash);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .mega-subicon {
    flex: none;
    color: var(--color-pumice);
    transition: color 0.2s;
  }

  .menu-cta {
    padding-top: 24px;
  }

  /* ---------- Wide: tabs in the header, full-width mega menus ---------- */

  .site-header:global(.is-wide) .menu-button,
  .site-header:global(.is-wide) .menu-cta {
    display: none;
  }

  .site-header:global(.is-wide) .site-menu {
    position: static;
    display: flex;
    align-items: center;
    gap: 2px;
    width: auto;
    height: auto;
    padding: 0;
    overflow: visible;
    background: transparent;
    border: 0;
  }

  .site-header:global(.is-wide) .site-menu::backdrop {
    display: none;
  }

  .site-header:global(.is-wide) .nav-item {
    border: 0;
  }

  .site-header:global(.is-wide) .tab {
    gap: 6px;
    width: auto;
    padding: 8px 11px;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: rgb(232 230 225 / 0.78);
    border-radius: var(--radius-button);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .site-header:global(.is-wide) .tab:hover,
  .site-header:global(.is-wide) .tab[aria-expanded='true'],
  .site-header:global(.is-wide) .is-current > .tab,
  .site-header:global(.is-wide) .tab[aria-current='page'] {
    color: var(--color-ash);
  }

  .site-header:global(.is-wide) .tab[aria-expanded='true'] {
    background-color: rgb(232 230 225 / 0.06);
  }

  /* The current section gets a straight amber rule under its label. An inset box-shadow
     would bend up at the ends with the tab's rounded corners. */
  .site-header:global(.is-wide) .is-current > .tab,
  .site-header:global(.is-wide) .tab[aria-current='page'] {
    background-image: linear-gradient(var(--color-amber), var(--color-amber));
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: calc(100% - 22px) 1px;
  }

  .site-header:global(.is-wide) .tab-chevron {
    width: 12px;
    height: 12px;
  }

  /* Hide panels until script makes them popovers, so they can't widen the measured row */
  .site-header:global(.is-wide) .mega:not(:is(:popover-open, .\:popover-open)) {
    display: none;
  }

  .site-header:global(.is-wide) .mega:is(:popover-open, .\:popover-open) {
    position: fixed;
    inset: var(--nav-h) 0 auto 0;
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: visible;
    color: var(--color-ash);
    background: var(--night);
    border: 0;
    border-bottom: 1px solid var(--hairline-strong);
    box-shadow: 0 48px 96px -36px rgb(0 0 0 / 0.9);
  }

  /* A bridge over the gap between the tab and the panel, so hover preview survives the trip */
  .site-header:global(.is-wide) .mega::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 16px;
  }

  .site-header:global(.is-wide) .mega-scroll {
    max-height: calc(100dvh - var(--nav-h) - 58px);
    overflow: auto;
  }

  .site-header:global(.is-wide) .mega-body {
    display: grid;
    grid-template-columns: minmax(0, 27fr) minmax(0, 46fr) minmax(0, 27fr);
    max-width: var(--max);
    margin-inline: auto;
  }

  .site-header:global(.is-wide) .mega-intro {
    display: flex;
    flex-direction: column;
    padding: 36px 36px 28px var(--margin);
    background: linear-gradient(180deg, rgb(var(--amethyst-rgb) / 0) 30%, rgb(var(--amethyst-rgb) / 0.16));
    border-right: 1px solid var(--hairline);
  }

  .site-header:global(.is-wide) .mega-headline,
  .site-header:global(.is-wide) .mega-description,
  .site-header:global(.is-wide) .mega-scene {
    display: block;
  }

  .site-header:global(.is-wide) .mega-headline {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 0.98;
    letter-spacing: -0.01em;
  }

  .site-header:global(.is-wide) .mega-description {
    margin-top: 16px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(232 230 225 / 0.72);
  }

  .site-header:global(.is-wide) .mega-all {
    align-self: flex-start;
    margin: 18px 0 0;
    color: var(--color-ash);
    font-weight: 500;
    text-decoration-color: rgb(232 230 225 / 0.35);
  }

  .site-header:global(.is-wide) .mega-all:hover {
    text-decoration-color: var(--color-ash);
  }

  .site-header:global(.is-wide) .mega-scene {
    margin-top: auto;
    padding-top: 28px;
  }

  .site-header:global(.is-wide) .mega-primary,
  .site-header:global(.is-wide) .mega-secondary {
    padding: 30px 32px 28px;
  }

  .site-header:global(.is-wide) .mega-secondary {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--hairline);
    padding-right: var(--margin);
  }

  .site-header:global(.is-wide) .mega-group {
    margin: 0 0 8px;
    font-size: 0.875rem;
    color: var(--color-pumice);
  }

  .site-header:global(.is-wide) .mega-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 20px;
  }

  .site-header:global(.is-wide) .mega-grid--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .site-header:global(.is-wide) .mega-section + .mega-section {
    margin-top: 24px;
  }

  .site-header:global(.is-wide) .mega-sublink {
    padding: 8px 10px;
    margin-inline: -10px;
    border-radius: 6px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .site-header:global(.is-wide) .mega-sublink:hover {
    color: var(--color-white);
    background: rgb(232 230 225 / 0.04);
  }

  .site-header:global(.is-wide) .mega-sublink:hover .mega-subicon {
    color: var(--color-glacier);
  }

  .site-header:global(.is-wide) .mega-link {
    padding: 12px;
    margin-inline: -12px;
    border-radius: 6px;
    transition: background-color 0.2s;
  }

  .site-header:global(.is-wide) .mega-link:hover {
    background: rgb(232 230 225 / 0.04);
  }

  .site-header:global(.is-wide) .mega-link:hover .mega-title {
    color: var(--color-white);
  }

  .site-header:global(.is-wide) .mega-link:hover .mega-icon {
    border-color: rgb(110 231 249 / 0.45);
  }

  .site-header:global(.is-wide) .mega-icon {
    width: 44px;
    height: 44px;
    transition: border-color 0.2s;
  }

  .site-header:global(.is-wide) .mega-title {
    font-size: 1.0625rem;
  }

  .site-header:global(.is-wide) .mega-desc {
    font-size: 0.9375rem;
  }

  .site-header:global(.is-wide) .mega-story {
    display: grid;
    gap: 6px;
    margin-top: auto;
    padding: 18px 0 0;
    border-top: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
  }

  .site-header:global(.is-wide) .mega-secondary .mega-section + .mega-story {
    margin-top: 28px;
  }

  .mega-story-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-pumice);
  }

  .mega-story-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.08;
    color: var(--color-ash);
  }

  .mega-story:hover .mega-story-title {
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .mega-story-meta {
    font-size: 0.875rem;
    color: var(--color-pumice);
  }

  .site-header:global(.is-wide) .mega-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--max);
    margin-inline: auto;
    padding: 16px var(--margin);
    border-top: 1px solid var(--hairline);
    font-size: 0.9375rem;
    color: rgb(232 230 225 / 0.72);
  }

  .site-header:global(.is-wide) .mega-foot a {
    flex: none;
    color: var(--color-ash);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-color: rgb(232 230 225 / 0.35);
  }

  .site-header:global(.is-wide) .mega-foot a:hover {
    text-decoration-color: var(--color-ash);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header:global(.is-wide) .mega:is(:popover-open, .\:popover-open) {
      transition:
        opacity 0.18s ease-out,
        translate 0.22s var(--ease-out),
        display 0.22s,
        overlay 0.22s;
      transition-behavior: allow-discrete;

      @starting-style {
        opacity: 0;
        translate: 0 -6px;
      }
    }
  }

  .site-header:global(.is-measuring) * {
    transition: none !important;
  }

  @media (max-width: 420px) {
    .brand-name {
      display: none;
    }
  }
</style>
