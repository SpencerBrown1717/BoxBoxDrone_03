---
/**
 * The home story in one continuous stage: the cost line drops and becomes the
 * horizon, and the sky above it plays each scene as its copy scrolls by.
 *
 * Two modes:
 * - Animated (default when motion is allowed): one sticky stage holds the line
 *   and the sky; the scroll drives the choreography.
 * - Still (no script, or reduced motion): the finished hero frame, then a sticky
 *   sky that changes its picture per scene, with no motion.
 */
import Barrier from './Barrier.astro';
import SkyField from './SkyField.astro';
import SectorScene from './SectorScene.astro';
import ModelPanel from './ModelPanel.astro';
import { sky, missions } from '../content/home';

// The story opens on delivery, then shows the model that flies it, then the other missions
const [lead, ...rest] = missions;
const blocks = [lead, 'model', ...rest] as const;
---

<section class="story" data-story aria-label="What BBD builds">
  <div class="stage" data-stage>
    <SkyField />
    <Barrier />
    <button class="motion-toggle button button--secondary button--sm" type="button" data-motion-toggle hidden>Pause motion</button>
  </div>

  <div class="track" data-track>
    <div class="hero-spacer" data-hero-spacer aria-hidden="true"></div>
    <SectorScene id={sky.id} scene="swarm" headline={sky.headline} support={sky.support} />
    {
      blocks.map((block) =>
        block === 'model' ? (
          <ModelPanel />
        ) : (
          <SectorScene
            id={block.id}
            scene={block.scene}
            eyebrow={block.eyebrow}
            headline={block.headline}
            support={block.support}
            beats={'beats' in block ? block.beats : undefined}
          >
            <a class="scene-link text-link" href={block.link.href}>
              {block.link.label}
            </a>
          </SectorScene>
        ),
      )
    }
  </div>
</section>

<script>
  import '../scripts/story';
</script>

<style>
  .story {
    position: relative;
    display: flex;
    flex-direction: column;
    --floor-gap: 56px;
    --hero-scroll: 150svh;
  }

  @media (min-width: 768px) {
    .story {
      --floor-gap: 72px;
      --hero-scroll: 175svh;
    }
  }

  /* Still mode: the stage dissolves, so the hero is its own screen and the sky follows it */
  .stage {
    display: contents;
  }

  .track {
    order: 2;
    position: relative;
    z-index: 2;
    margin-top: -100svh;
    pointer-events: none;
  }

  .track :global(.model-panel) {
    pointer-events: auto;
  }

  .hero-spacer {
    height: 0;
  }

  /* Animated mode: one sticky stage */
  :global(.motion-ok) .stage {
    display: block;
    position: sticky;
    top: 0;
    order: 0;
    z-index: 1;
    height: 100svh;
    overflow: hidden;
  }

  :global(.motion-ok) .hero-spacer {
    height: calc(100svh + var(--hero-scroll));
  }

  .motion-toggle {
    position: absolute;
    right: var(--margin);
    bottom: 12px;
    z-index: 4;
  }

  .motion-toggle[hidden] {
    display: none;
  }

  /* Only offered once the sky, which moves on its own, is on screen */
  .story:not(:global(.is-past-hero)) .motion-toggle {
    visibility: hidden;
  }

  @media (max-width: 767px) {
    .motion-toggle {
      bottom: calc(6px + env(safe-area-inset-bottom));
    }
  }
</style>
