---
/**
 * Scenes 1 and 2. Two copies of the same layout sit on top of each other:
 * "then" (the last mile on the road) and "now" (the last mile, flown).
 * The glowing line is the boundary between them. Everything above it is now,
 * everything below it is still then, so as it sweeps down the screen it rewrites
 * the headline and every rung of the scale. When it lands it becomes the ground
 * line the field is drawn under.
 *
 * Without script, or with reduced motion, only the finished "now" frame shows,
 * with the line at the floor.
 */
import Button from './Button.astro';
import HeroRoutes from './HeroRoutes.astro';
import { hero } from '../content/home';
---

<div class="hero" data-hero>
  <div class="hero-group" data-hero-group>
    <div class="layer layer--then" data-layer="then">
      <div class="layer-inner" data-layer-inner>
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="copy-stack">
              <div class="copy">
                <p class="hero-headline">{hero.then.headline}</p>
                <p class="hero-support">{hero.then.support}</p>
              </div>
              <div class="copy copy--ghost" aria-hidden="true">
                <p class="hero-headline">{hero.now.headline}</p>
                <p class="hero-support">{hero.now.support}</p>
                <span class="cta-ghost"></span>
              </div>
            </div>
          </div>
          <ol class="scale" aria-label="What the last mile has taken">
            {
              hero.scale.map((row) => (
                <li class="scale-row">
                  <span class="scale-tick" aria-hidden="true" />
                  <span class="scale-label">{row.then.label}</span>
                  <span class="scale-value" set:html={row.then.value} />
                </li>
              ))
            }
          </ol>
        </div>
        <p class="hint" aria-hidden="true"><span class="hint-line"></span>{hero.then.hint}</p>
      </div>
    </div>

    <div class="layer layer--now" data-layer="now">
      <div class="layer-inner" data-layer-inner>
        <HeroRoutes />
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="copy-stack">
              <div class="copy copy--ghost" aria-hidden="true">
                <p class="hero-headline">{hero.then.headline}</p>
                <p class="hero-support">{hero.then.support}</p>
              </div>
              <div class="copy">
                <h1 class="hero-headline">{hero.now.headline}</h1>
                <p class="hero-support">{hero.now.support}</p>
                <div class="hero-cta" data-hero-cta>
                  <Button href="/contact" size="lg">{hero.now.cta}</Button>
                </div>
              </div>
            </div>
          </div>
          <ol class="scale" aria-label="What it takes now">
            {
              hero.scale.map((row) => (
                <li class="scale-row">
                  <span class="scale-tick" aria-hidden="true" />
                  <span class="scale-label">{row.now.label}</span>
                  <span class="scale-value" set:html={row.now.value} />
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <div class="bar" data-bar aria-hidden="true">
      <span class="bar-glow" data-bar-glow><span class="bar-breath"></span></span>
      <span class="bar-cool" data-bar-cool></span>
      <span class="bar-hot" data-bar-hot></span>
      <span class="bar-spark" data-spark="left"></span>
      <span class="bar-spark" data-spark="right"></span>
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: var(--color-obsidian);
  }

  :global(.motion-ok) .hero {
    position: absolute;
    inset: 0;
    height: auto;
    min-height: 0;
    overflow: visible;
    background: transparent;
  }

  .hero-group,
  .layer,
  .layer-inner {
    position: absolute;
    inset: 0;
  }

  /* The lit world carries an iridescent glow and sheen behind the headline */
  .layer--now > .layer-inner {
    background: var(--hero-glow);
  }

  .layer--then {
    display: none;
  }

  :global(.motion-ok) .layer {
    overflow: hidden;
  }

  :global(.motion-ok) .layer--then {
    display: block;
  }

  /* The first frame, before scripts attach: barrier high, everything below it still "then" */
  :global(.motion-ok) .layer--now {
    transform: translate3d(0, calc(var(--nav-h) + 10px - 100svh), 0);
  }

  :global(.motion-ok) .layer--now > .layer-inner {
    transform: translate3d(0, calc(100svh - var(--nav-h) - 10px), 0);
  }

  :global(.motion-ok) .layer--then {
    transform: translate3d(0, calc(var(--nav-h) + 10px), 0);
  }

  :global(.motion-ok) .layer--then > .layer-inner {
    transform: translate3d(0, calc(-1 * (var(--nav-h) + 10px)), 0);
  }

  /* Layout shared by both layers, so every rung sits in exactly the same place */
  .hero-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 32px;
    align-content: center;
    max-width: var(--max);
    margin-inline: auto;
    padding: calc(var(--nav-h) + 48px) var(--margin) calc(var(--floor-gap) + 24px);
  }

  .hero-copy,
  .scale {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .hero-grid {
      align-items: center;
    }

    .hero-copy {
      grid-column: 1 / span 5;
    }

    .scale {
      grid-column: 6 / -1;
    }
  }

  @media (min-width: 1200px) {
    .hero-copy {
      grid-column: 1 / span 7;
    }

    .scale {
      grid-column: 9 / -1;
    }
  }

  .copy-stack {
    display: grid;
  }

  .copy-stack > .copy {
    grid-area: 1 / 1;
  }

  .copy--ghost {
    visibility: hidden;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--t-hero);
    line-height: 0.95;
    letter-spacing: -0.012em;
    max-width: 9.6em;
    text-wrap: balance;
  }

  .hero-support {
    margin-top: 24px;
    max-width: 34ch;
    font-size: var(--t-lead);
    line-height: 1.5;
  }

  .hero-cta,
  .cta-ghost {
    display: block;
    margin-top: 32px;
    height: 52px;
  }

  /* Then: the old world, dim */
  .layer--then {
    color: var(--color-pumice);
  }

  .layer--then .hero-headline {
    color: rgb(139 143 152 / 0.92);
  }

  .layer--then .hero-support {
    color: rgb(139 143 152 / 0.88);
  }

  /* Now: lit */
  .layer--now {
    color: var(--color-ash);
  }

  .layer--now .hero-support {
    color: rgb(232 230 225 / 0.82);
  }

  /* The height scale beside the barrier */
  .scale {
    position: relative;
    margin: 0;
    padding: 0 0 0 32px;
    list-style: none;
  }

  .scale::before,
  .scale::after {
    content: '';
    position: absolute;
    left: 0;
    top: -28px;
    bottom: -28px;
  }

  .scale::before {
    width: 1px;
    background: currentColor;
    opacity: 0.32;
  }

  .scale::after {
    width: 6px;
    background: repeating-linear-gradient(to bottom, currentColor 0 1px, transparent 1px 10px);
    opacity: 0.22;
  }

  .layer--now .scale {
    color: var(--color-glacier);
  }

  .scale-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 46px;
  }

  .scale-tick {
    position: absolute;
    left: -30px;
    top: 50%;
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.75;
  }

  .scale-label {
    font-size: 1rem;
    white-space: nowrap;
  }

  .layer--now .scale-label {
    color: var(--color-ash);
  }

  .scale-value {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0.85;
  }

  .layer--now .scale-value {
    color: var(--color-glacier);
    opacity: 1;
  }

  @media (min-width: 900px) {
    .scale-row {
      height: 72px;
    }

    .scale-label {
      font-size: 1.1875rem;
    }

    .scale-value {
      font-size: 0.9375rem;
    }
  }

  /* The instruction sits right under the barrier, so the barrier erases it first */
  .hint {
    position: absolute;
    top: calc(var(--nav-h) + 22px);
    right: var(--margin);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--color-pumice);
  }

  .hint-line {
    position: relative;
    width: 1px;
    height: 18px;
    background: rgb(139 143 152 / 0.4);
    overflow: hidden;
  }

  .hint-line::after {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 5px;
    background: var(--color-amethyst);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hint-line::after {
      animation: hint-drop 1.8s var(--ease-out) 5;
    }
  }

  :global([data-motion='paused']) .hint-line::after {
    animation-play-state: paused;
  }

  @keyframes hint-drop {
    from {
      translate: 0 -6px;
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    to {
      translate: 0 18px;
      opacity: 0;
    }
  }

  /* The barrier */
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--floor-gap);
    height: 0;
    z-index: 3;
    pointer-events: none;
  }

  :global(.motion-ok) .bar {
    top: 0;
    bottom: auto;
    transform: translate3d(0, calc(var(--nav-h) + 10px), 0);
  }

  .bar-hot,
  .bar-cool {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
  }

  .bar-hot {
    background: var(--opal-line);
    box-shadow: var(--opal-glow);
  }

  .bar-cool {
    background: linear-gradient(90deg, transparent, var(--amethyst-deep) 8%, var(--amethyst-dusk) 50%, var(--amethyst-deep) 92%, transparent);
    opacity: 0;
  }

  .bar-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: -110px;
    height: 220px;
  }

  .bar-breath {
    position: absolute;
    inset: 0;
    background: var(--opal-halo);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar-breath {
      animation: breathe 4.6s ease-in-out 6 alternate;
    }
  }

  :global([data-motion='paused']) .bar-breath {
    animation-play-state: paused;
  }

  @keyframes breathe {
    from {
      opacity: 0.7;
    }
    to {
      opacity: 1;
    }
  }

  .bar-spark {
    position: absolute;
    top: -2px;
    left: 50%;
    width: 300px;
    height: 4px;
    margin-left: -150px;
    border-radius: 4px;
    background: radial-gradient(closest-side, #ffffff, rgb(110 231 249 / 0.95) 40%, rgb(110 231 249 / 0));
    box-shadow: 0 0 18px 2px rgb(110 231 249 / 0.35);
    opacity: 0;
  }

  /* Shorter phones (iPhone SE and similar): tighten everything so it fits above the floor */
  @media (max-height: 760px) and (max-width: 899px) {
    .hero-grid {
      row-gap: 16px;
      padding-top: calc(var(--nav-h) + 40px);
      padding-bottom: calc(var(--floor-gap) + 16px);
    }

    .hero-headline {
      font-size: min(var(--t-hero), 6.6svh);
    }

    .hero-support {
      margin-top: 16px;
      font-size: 0.9375rem;
    }

    .hero-cta,
    .cta-ghost {
      margin-top: 16px;
    }

    .scale-row {
      height: 34px;
    }
  }
</style>
