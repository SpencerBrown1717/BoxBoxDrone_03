---
/**
 * The last scene of the home page: one action, and who it is for.
 */
import Button from './Button.astro';
import { closing } from '../content/home';
---

<section class="closing" id={closing.id} aria-labelledby="closing-title">
  <div class="closing-inner">
    <h2 class="closing-title" id="closing-title">{closing.headline}</h2>
    <p class="closing-support">{closing.support}</p>
    <div class="closing-cta">
      <Button href="/contact" size="lg">{closing.cta}</Button>
    </div>
    <ul class="audiences" aria-label="Who we work with">
      {closing.audiences.map((audience) => <li>{audience}</li>)}
    </ul>
  </div>
</section>

<style>
  .closing {
    padding-block: clamp(120px, 20svh, 240px) clamp(120px, 18svh, 200px);
    background: var(--color-obsidian);
    border-top: 1px solid var(--hairline);
  }

  .closing-inner {
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .closing-title {
    font-size: var(--t-hero);
    line-height: 0.95;
    max-width: 8em;
  }

  .closing-support {
    margin-top: 24px;
    max-width: 40ch;
    font-size: var(--t-lead);
    color: rgb(232 230 225 / 0.8);
  }

  .closing-cta {
    margin-top: 32px;
  }

  .audiences {
    display: grid;
    gap: 8px;
    margin: 64px 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-small);
    color: var(--color-pumice);
  }

  @media (min-width: 1024px) {
    .audiences {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
    }

    .audiences li {
      padding-inline: 24px;
      border-left: 1px solid var(--hairline-strong);
    }

    .audiences li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
