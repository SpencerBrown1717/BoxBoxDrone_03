---
/**
 * Scene 8: the line becomes a timeline. Sensing now, networking and computing next.
 */
import { roadmap } from '../content/home';

interface Props {
  id?: string;
  title?: string;
  support?: string;
}

const { id = roadmap.id, title = roadmap.headline, support = roadmap.support } = Astro.props;
---

<section class="roadmap" id={id} aria-labelledby={`${id}-title`}>
  <div class="roadmap-inner">
    <div class="roadmap-head">
      <h2 class="roadmap-title" id={`${id}-title`}>{title}</h2>
      <p class="roadmap-support">{support}</p>
    </div>

    <ol class="timeline">
      {
        roadmap.stages.map((stage, i) => (
          <li class:list={['stage', i === 0 && 'stage--now']}>
            <span class="node" aria-hidden="true" />
            <p class="stage-when">{stage.when}</p>
            <h3 class="stage-name">{stage.name}</h3>
            <p class="stage-detail">{stage.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .roadmap {
    position: relative;
    padding-block: clamp(120px, 18svh, 220px) clamp(96px, 14svh, 180px);
    background: var(--color-obsidian);
  }

  .roadmap-inner {
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .roadmap-title {
    font-size: var(--t-display);
    max-width: 11em;
  }

  .roadmap-support {
    margin-top: 20px;
    max-width: 40ch;
    font-size: var(--t-lead);
    color: rgb(232 230 225 / 0.78);
  }

  .timeline {
    position: relative;
    display: grid;
    gap: 44px;
    margin: 72px 0 0;
    padding: 0 0 0 36px;
    list-style: none;
    --node: 13px;
  }

  /* Phones: a vertical line down the left */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 6px;
    bottom: 6px;
    width: 1px;
  }

  /* The rail: what's ahead, dashed */
  .timeline::before {
    background: repeating-linear-gradient(to bottom, rgb(139 143 152 / 0.55) 0 4px, transparent 4px 9px);
  }

  /* The part already built, solid glacier */
  .timeline::after {
    bottom: auto;
    height: 34%;
    background: var(--color-glacier);
    transform-origin: top;
  }

  .stage {
    position: relative;
  }

  .node {
    position: absolute;
    left: -36px;
    top: 4px;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    border: 1px solid rgb(139 143 152 / 0.8);
    background: var(--color-obsidian);
  }

  .stage--now .node {
    border-color: var(--color-glacier);
    background: var(--color-glacier);
    box-shadow:
      0 0 0 5px rgb(110 231 249 / 0.12),
      0 0 18px rgb(110 231 249 / 0.6);
  }

  .stage-when {
    font-size: var(--t-small);
    color: var(--color-pumice);
  }

  .stage--now .stage-when {
    color: var(--color-glacier);
  }

  .stage-name {
    margin-top: 6px;
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.75rem);
  }

  /* Body text: --t-body, 17px on phones and 18px from 768px */
  .stage-detail {
    margin-top: 8px;
    max-width: 30ch;
    font-size: var(--t-body);
    color: rgb(232 230 225 / 0.86);
  }

  /* Wider screens: the same line, horizontal */
  @media (min-width: 768px) {
    .timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gutter);
      padding: 44px 0 0;
    }

    .timeline::before,
    .timeline::after {
      left: 0;
      right: 0;
      top: 6px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .timeline::before {
      background: repeating-linear-gradient(to right, rgb(139 143 152 / 0.55) 0 4px, transparent 4px 9px);
    }

    .timeline::after {
      right: auto;
      width: calc(100% / 3);
      transform-origin: left;
    }

    .node {
      left: 0;
      top: -44px;
    }
  }

  /* The line draws itself as the section scrolls in */
  @supports ((animation-timeline: view()) and (animation-range: 0% 100%)) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::after {
        animation: draw-down linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 45%;
      }

      @media (min-width: 768px) {
        .timeline::after {
          animation-name: draw-across;
        }
      }
    }
  }

  @keyframes draw-down {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes draw-across {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
