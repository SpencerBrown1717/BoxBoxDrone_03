---
/**
 * How it works. A sequence gets numbers and a connecting line; parts of a whole
 * (the equipment stack) are a plain grid with no numbers.
 */
import type { Step } from '../../content/topics/types';
import Icon from '../Icon.astro';

interface Props {
  steps: Step[];
  sequence?: boolean;
}

const { steps, sequence = true } = Astro.props;
const Tag = sequence ? 'ol' : 'ul';
---

<Tag class:list={['flow', sequence ? 'flow--sequence' : 'flow--grid']} style={`--count:${steps.length}`}>
  {
    steps.map((step, i) => (
      <li class="flow-step">
        <div class="flow-mark">
          <span class="flow-icon">
            <Icon name={step.icon} size={24} />
          </span>
          {sequence && <span class="flow-number">{String(i + 1).padStart(2, '0')}</span>}
        </div>
        <h3 class="flow-title">{step.title}</h3>
        <p class="flow-text">{step.text}</p>
      </li>
    ))
  }
</Tag>

<style>
  .flow {
    display: grid;
    gap: 34px var(--gutter);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .flow--sequence {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }

    .flow--grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .flow-step {
    position: relative;
  }

  .flow-mark {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* The line that joins a sequence, drawn between the icons */
  @media (min-width: 1100px) {
    .flow--sequence .flow-step:not(:last-child) .flow-mark::after {
      content: '';
      flex: 1;
      height: 1px;
      margin-right: 10px;
      background: linear-gradient(90deg, rgb(110 231 249 / 0.45), rgb(110 231 249 / 0.08));
    }
  }

  .flow-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    color: var(--color-glacier);
    background: var(--night-raised);
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
  }

  .flow-number {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-pumice);
  }

  .flow-title {
    margin-top: 20px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 1.1875rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .flow-text {
    margin-top: 10px;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(232 230 225 / 0.74);
  }
</style>
