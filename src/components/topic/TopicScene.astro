---
/**
 * A drawn scene from src/lib/scenes.ts. As a hero it carries labels, gentle
 * motion and a pause control; as a thumbnail it is a quiet still.
 * The picture is hidden from assistive technology: the caption and the page
 * tell the same story in text. On narrow screens the in-picture labels give
 * way to a list below the picture.
 */
import { drawScene, SCENE_H, SCENE_W } from '../../lib/scenes';
import type { SceneName } from '../../content/topics/types';

interface Props {
  scene: SceneName;
  caption?: string;
  thumb?: boolean;
  class?: string;
}

const { scene, caption, thumb = false, class: className } = Astro.props;
const { body, labels } = drawScene(scene);
---

<figure class:list={['scene', thumb ? 'scene--thumb' : 'scene--hero', className]} data-scene-figure={thumb ? undefined : ''}>
  <svg
    class="scene-svg"
    viewBox={`0 0 ${SCENE_W} ${SCENE_H}`}
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    focusable="false"
    set:html={body}
  />
  {
    !thumb && (
      <>
        {caption && <figcaption class="visually-hidden">{caption}</figcaption>}
        <ul class="scene-legend" aria-hidden="true">
          {labels.map((text) => (
            <li>{text}</li>
          ))}
        </ul>
        <button class="scene-toggle button button--secondary button--sm" type="button" data-motion-toggle hidden>
          Pause motion
        </button>
      </>
    )
  }
</figure>

<script>
  import { isPaused, onMotionChange, wireToggle } from '../../scripts/motion';

  const motionOk = () => document.documentElement.classList.contains('motion-ok');

  for (const figure of document.querySelectorAll<HTMLElement>('[data-scene-figure]')) {
    const svg = figure.querySelector<SVGSVGElement>('svg');
    if (!svg) continue;
    if (!motionOk()) continue;

    figure.classList.add('is-animated');
    wireToggle(figure.querySelector<HTMLButtonElement>('[data-motion-toggle]'));

    // SMIL motion waits for an explicit start, so reduced motion never sees it move
    const smil = [...svg.querySelectorAll<SVGAnimationElement>('animate, animateMotion')];
    if (smil.length) {
      for (const anim of smil) {
        const delay = Number(anim.dataset.delay ?? 0);
        if (delay) anim.beginElementAt(delay);
        else anim.beginElement();
      }
      figure.classList.add('is-moving');
    }
    if (isPaused()) svg.pauseAnimations();
    onMotionChange((paused) => (paused ? svg.pauseAnimations() : svg.unpauseAnimations()));
  }
</script>

<style>
  .scene {
    position: relative;
    margin: 0;
    container-type: inline-size;
  }

  .scene-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .scene-legend {
    display: none;
  }

  /* Narrow: labels move out of the picture into a list. Below this width the
     drawing scales its 17px labels under the 14px floor. */
  @container (max-width: 989px) {
    .scene-svg :global(.lbl),
    .scene-svg :global(.leader) {
      display: none;
    }

    .scene--hero .scene-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      line-height: 1.4;
      color: var(--color-pumice);
    }

    .scene--hero .scene-legend li::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      margin-right: 7px;
      vertical-align: 0.1em;
      background: var(--color-glacier);
      transform: rotate(45deg);
    }
  }

  .scene--thumb .scene-svg :global(.lbl),
  .scene--thumb .scene-svg :global(.leader) {
    display: none;
  }

  .scene-toggle {
    position: absolute;
    right: 0;
    bottom: -48px;
  }

  .scene-toggle[hidden] {
    display: none;
  }

  /* ---------- The drawing ---------- */

  .scene :global(.lbl) {
    fill: var(--color-pumice);
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 400;
    /* A halo in the background color, so a line passing behind a label can't cut through it */
    paint-order: stroke;
    stroke: var(--night);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .scene :global(.leader) {
    fill: none;
    stroke: rgb(139 143 152 / 0.45);
    stroke-width: 1;
  }

  .scene :global(.dots) {
    stroke: rgb(110 231 249 / 0.32);
    stroke-width: 2.6;
    stroke-linecap: square;
  }

  .scene :global(.dots.soft) {
    stroke: rgb(110 231 249 / 0.16);
    stroke-width: 1.8;
  }

  .scene :global(.ground),
  .scene :global(.baseline) {
    fill: none;
    stroke: var(--basalt-line);
    stroke-width: 1.5;
  }

  .scene :global(.mark),
  .scene :global(.house) {
    fill: none;
    stroke: rgb(232 230 225 / 0.55);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .scene :global(.tick) {
    fill: none;
    stroke: rgb(139 143 152 / 0.55);
    stroke-width: 1.4;
  }

  .scene :global(.window),
  .scene :global(.parcel),
  .scene :global(.door) {
    fill: var(--color-amber);
  }

  .scene :global(.pad) {
    fill: var(--color-glacier);
  }

  .scene :global(.route) {
    fill: none;
    stroke: rgb(110 231 249 / 0.65);
    stroke-width: 1.6;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }

  .scene :global(.route.soft) {
    stroke: rgb(110 231 249 / 0.25);
  }

  .scene :global(.tether) {
    stroke: rgb(232 230 225 / 0.6);
    stroke-width: 1.2;
  }

  .scene :global(.craft-body) {
    fill: var(--color-ash);
  }

  .scene :global(.craft-arm) {
    fill: none;
    stroke: var(--color-ash);
    stroke-width: 2;
  }

  .scene :global(.craft-rotor) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .scene :global(.wind) {
    fill: none;
    stroke: rgb(110 231 249 / 0.5);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scene :global(.rain) {
    fill: none;
    stroke: rgb(232 230 225 / 0.18);
    stroke-width: 1.2;
  }

  .scene :global(.track) {
    fill: none;
    stroke: rgb(110 231 249 / 0.22);
    stroke-width: 1.2;
    stroke-dasharray: 2 6;
  }

  .scene :global(.target) {
    stroke: var(--color-glacier);
    stroke-width: 6;
    stroke-linecap: square;
  }

  .scene :global(.hit) {
    fill: none;
    stroke: var(--color-amber);
    stroke-width: 1.8;
  }

  .scene :global(.fall) {
    fill: none;
    stroke: rgb(242 182 107 / 0.55);
    stroke-width: 1.3;
    stroke-dasharray: 3 6;
  }

  .scene :global(.form),
  .scene :global(.form-hi),
  .scene :global(.form-trunk),
  .scene :global(.spare) {
    stroke-width: 5;
    stroke-linecap: square;
  }

  .scene :global(.form) {
    stroke: var(--color-glacier);
  }

  .scene :global(.form-hi) {
    stroke: var(--iris-violet);
  }

  .scene :global(.form-trunk) {
    stroke: var(--color-amber);
  }

  .scene :global(.spare) {
    stroke: rgb(110 231 249 / 0.55);
    stroke-width: 4;
  }

  .scene :global(.frame-box) {
    fill: var(--night);
    stroke: rgb(232 230 225 / 0.5);
    stroke-width: 1.4;
  }

  .scene :global(.frame-box.dim) {
    stroke: rgb(232 230 225 / 0.22);
  }

  .scene :global(.model-box) {
    fill: rgb(110 231 249 / 0.05);
    stroke: rgb(110 231 249 / 0.6);
    stroke-width: 1.5;
  }

  .scene :global(.model-grid) {
    stroke: var(--color-glacier);
    stroke-width: 5;
    stroke-linecap: square;
  }

  .scene :global(.arrow) {
    fill: none;
    stroke: rgb(232 230 225 / 0.5);
    stroke-width: 1.4;
  }

  .scene :global(.block) {
    fill: rgb(232 230 225 / 0.04);
    stroke: rgb(232 230 225 / 0.42);
    stroke-width: 1.4;
  }

  .scene :global(.imagined) {
    fill: none;
    stroke: rgb(110 231 249 / 0.42);
    stroke-width: 1.4;
    stroke-dasharray: 4 6;
  }

  .scene :global(.blocked) {
    fill: none;
    stroke: rgb(139 143 152 / 0.55);
    stroke-width: 1.4;
    stroke-dasharray: 2 6;
  }

  .scene :global(.imagined-end) {
    fill: rgb(110 231 249 / 0.6);
  }

  .scene :global(.blocked-end) {
    fill: rgb(139 143 152 / 0.7);
  }

  .scene :global(.chosen) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  .scene :global(.frame) {
    fill: none;
    stroke: rgb(232 230 225 / 0.6);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .scene :global(.frame-plate),
  .scene :global(.battery),
  .scene :global(.camera) {
    fill: var(--night);
    stroke: rgb(232 230 225 / 0.6);
    stroke-width: 1.5;
  }

  .scene :global(.battery-cells) {
    stroke: rgb(232 230 225 / 0.3);
    stroke-width: 1.4;
    stroke-dasharray: 10 8;
  }

  .scene :global(.motor) {
    fill: var(--night);
    stroke: var(--color-ash);
    stroke-width: 1.6;
  }

  .scene :global(.prop) {
    fill: rgb(110 231 249 / 0.04);
    stroke: rgb(110 231 249 / 0.4);
    stroke-width: 1.2;
    stroke-dasharray: 4 6;
    transform-box: fill-box;
    transform-origin: center;
  }

  .scene :global(.explode) {
    fill: none;
    stroke: rgb(139 143 152 / 0.5);
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
  }

  .scene :global(.board) {
    fill: rgb(110 231 249 / 0.06);
    stroke: var(--color-glacier);
    stroke-width: 1.5;
  }

  .scene :global(.glow-box) {
    fill: none;
    stroke: rgb(110 231 249 / 0.14);
    stroke-width: 14;
  }

  .scene :global(.chip) {
    fill: var(--color-glacier);
  }

  .scene :global(.lens) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 2;
  }

  .scene :global(.mass) {
    stroke: rgb(232 230 225 / 0.55);
    stroke-width: 7;
    stroke-linecap: square;
  }

  .scene :global(.mass.us) {
    stroke: var(--color-glacier);
  }

  .scene :global(.ping) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 1.2;
    opacity: 0.25;
    transform-box: fill-box;
    transform-origin: center;
  }

  .scene :global(.ping.amber) {
    stroke: var(--color-amber);
  }

  /* Dots that ride SMIL paths stay hidden until their motion starts */
  .scene :global(.moving) {
    visibility: hidden;
  }

  .scene.is-moving :global(.moving) {
    visibility: visible;
  }

  .scene.is-moving :global(.static-only) {
    visibility: hidden;
  }

  /* ---------- Motion: only when the reader allows it ---------- */

  @keyframes scene-ping {
    from {
      transform: scale(0.4);
      opacity: 0.75;
    }

    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes scene-flow {
    to {
      stroke-dashoffset: -40;
    }
  }

  @keyframes scene-twinkle {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.55;
    }
  }

  @keyframes scene-sway {
    to {
      transform: rotate(360deg);
    }
  }

  .scene.is-animated :global(.ping) {
    animation: scene-ping 3.3s ease-out infinite;
  }

  .scene.is-animated :global(.flow) {
    animation: scene-flow 1.6s linear infinite;
  }

  .scene.is-animated :global(.twinkle) {
    animation: scene-twinkle 2.6s ease-in-out infinite;
  }

  .scene.is-animated :global(.sway) {
    animation: scene-sway 9s linear infinite;
  }

  :global(html[data-motion='paused']) .scene :global(*) {
    animation-play-state: paused !important;
  }
</style>
