---
/**
 * A drawn scene from src/lib/scenes.ts. As a hero it carries labels, gentle
 * motion and a pause control; as a thumbnail it is a quiet still.
 * The picture is hidden from assistive technology: the caption and the page
 * tell the same story in text. On narrow screens the in-picture labels give
 * way to a list below the picture.
 */
import { drawScene, SCENE_H, SCENE_W } from '../../lib/scenes';
import type { SceneName } from '../../content/topics/types';

interface Props {
  scene: SceneName;
  caption?: string;
  thumb?: boolean;
  class?: string;
}

const { scene, caption, thumb = false, class: className } = Astro.props;
const { body, labels } = drawScene(scene);
---

<figure class:list={['scene', thumb ? 'scene--thumb' : 'scene--hero', className]} data-scene-figure={thumb ? undefined : ''}>
  <svg
    class="scene-svg"
    viewBox={`0 0 ${SCENE_W} ${SCENE_H}`}
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    focusable="false"
    set:html={body}
  />
  {
    !thumb && (
      <>
        {caption && <figcaption class="visually-hidden">{caption}</figcaption>}
        <ul class="scene-legend" aria-hidden="true">
          {labels.map((text) => (
            <li>{text}</li>
          ))}
        </ul>
        <button class="scene-toggle button button--secondary button--sm" type="button" data-motion-toggle hidden>
          Pause motion
        </button>
      </>
    )
  }
</figure>

<script>
  import { isPaused, onMotionChange, wireToggle } from '../../scripts/motion';

  const motionOk = () => document.documentElement.classList.contains('motion-ok');

  for (const figure of document.querySelectorAll<HTMLElement>('[data-scene-figure]')) {
    const svg = figure.querySelector<SVGSVGElement>('svg');
    if (!svg) continue;
    if (!motionOk()) continue;

    figure.classList.add('is-animated');
    wireToggle(figure.querySelector<HTMLButtonElement>('[data-motion-toggle]'));

    // SMIL motion waits for an explicit start, so reduced motion never sees it move.
    // A negative data-delay starts a loop part way through, so nothing waits at the origin.
    const smil = [...svg.querySelectorAll<SVGAnimationElement>('animate, animateMotion')];
    if (smil.length) {
      for (const anim of smil) {
        const delay = Number(anim.dataset.delay ?? 0);
        if (delay) anim.beginElementAt(delay);
        else anim.beginElement();
      }
      figure.classList.add('is-moving');
    }
    if (isPaused()) svg.pauseAnimations();
    onMotionChange((paused) => (paused ? svg.pauseAnimations() : svg.unpauseAnimations()));
  }
</script>

<style>
  .scene {
    position: relative;
    margin: 0;
    container-type: inline-size;
  }

  .scene-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .scene-legend {
    display: none;
  }

  /* Narrow: labels move out of the picture into a list */
  @container (max-width: 639px) {
    .scene-svg :global(.lbl),
    .scene-svg :global(.leader) {
      display: none;
    }

    .scene--hero .scene-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      line-height: 1.4;
      color: var(--color-pumice);
    }

    .scene--hero .scene-legend li::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      margin-right: 7px;
      vertical-align: 0.1em;
      background: var(--color-glacier);
      transform: rotate(45deg);
    }
  }

  .scene--thumb .scene-svg :global(.lbl),
  .scene--thumb .scene-svg :global(.leader) {
    display: none;
  }

  .scene-toggle {
    position: absolute;
    right: 0;
    bottom: -48px;
  }

  .scene-toggle[hidden] {
    display: none;
  }

  /* ---------- The drawing ---------- */

  .scene :global(.lbl) {
    fill: var(--color-pumice);
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 400;
    /* A halo in the background color, so a line passing behind a label can't cut through it */
    paint-order: stroke;
    stroke: var(--night);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .scene :global(.gate-text) {
    fill: var(--color-ash);
    font-size: 16px;
  }

  .scene :global(.leader) {
    fill: none;
    stroke: rgb(139 143 152 / 0.45);
    stroke-width: 1;
  }

  .scene :global(.dots) {
    stroke: rgb(110 231 249 / 0.3);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .scene :global(.dots.soft) {
    stroke: rgb(110 231 249 / 0.13);
  }

  .scene :global(.ground) {
    fill: none;
    stroke: var(--basalt-line);
    stroke-width: 1.5;
  }

  .scene :global(.sea) {
    fill: none;
    stroke: rgb(110 231 249 / 0.55);
    stroke-width: 1.4;
  }

  .scene :global(.sea-tint) {
    fill: rgb(14 40 58 / 0.32);
  }

  .scene :global(.field) {
    fill: none;
    stroke: rgb(110 231 249 / 0.2);
    stroke-width: 1.2;
  }

  .scene :global(.field.strong),
  .scene :global(.lattice) {
    fill: none;
    stroke: rgb(110 231 249 / 0.4);
    stroke-width: 1.4;
  }

  .scene :global(.strata) {
    fill: none;
    stroke: rgb(110 231 249 / 0.22);
    stroke-width: 1.1;
  }

  .scene :global(.contour) {
    fill: none;
    stroke: rgb(110 231 249 / 0.13);
    stroke-width: 1.1;
  }

  .scene :global(.glow) {
    fill: none;
    stroke: rgb(110 231 249 / 0.14);
    stroke-width: 7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .scene :global(.hidden) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 1.8;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  .scene :global(.hull-fill),
  .scene :global(.salt-fill) {
    fill: rgb(var(--obsidian-rgb) / 0.6);
  }

  .scene :global(.trap-fill),
  .scene :global(.loop-fill),
  .scene :global(.pulse),
  .scene :global(.block) {
    fill: rgb(110 231 249 / 0.07);
  }

  .scene :global(.block) {
    stroke: rgb(110 231 249 / 0.5);
    stroke-width: 1.3;
  }

  .scene :global(.block.dim) {
    opacity: 0.45;
  }

  .scene :global(.signal),
  .scene :global(.fiber) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .scene :global(.signal.dim) {
    stroke: rgb(110 231 249 / 0.5);
  }

  .scene :global(.fiber-glow) {
    fill: none;
    stroke: rgb(110 231 249 / 0.13);
    stroke-width: 10;
    stroke-linecap: round;
  }

  .scene :global(.beam) {
    fill: none;
    stroke: rgb(110 231 249 / 0.28);
    stroke-width: 1.4;
  }

  .scene :global(.beam.strong) {
    stroke: rgb(110 231 249 / 0.6);
    stroke-width: 2;
  }

  .scene :global(.craft),
  .scene :global(.meter) {
    fill: none;
    stroke: rgb(232 230 225 / 0.62);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .scene :global(.craft.solid) {
    fill: var(--color-ash);
    stroke: none;
  }

  .scene :global(.craft.solid-dim),
  .scene :global(.gate),
  .scene :global(.station-box),
  .scene :global(.node),
  .scene :global(.instrument) {
    fill: var(--night);
    stroke: rgb(232 230 225 / 0.5);
    stroke-width: 1.4;
  }

  .scene :global(.plate) {
    fill: var(--night);
    stroke: rgb(232 230 225 / 0.3);
    stroke-width: 1.2;
  }

  .scene :global(.plate-edge) {
    fill: none;
    stroke: rgb(232 230 225 / 0.2);
    stroke-width: 1.2;
  }

  .scene :global(.cell) {
    fill: rgb(110 231 249 / 0.035);
    stroke: rgb(232 230 225 / 0.45);
    stroke-width: 1.4;
  }

  .scene :global(.chip) {
    fill: rgb(var(--night-rgb) / 0.7);
    stroke: rgb(232 230 225 / 0.45);
    stroke-width: 1.2;
  }

  .scene :global(.drop) {
    fill: rgb(110 231 249 / 0.12);
    stroke: rgb(110 231 249 / 0.5);
  }

  .scene :global(.sensor-stem) {
    stroke: var(--color-glacier);
    stroke-width: 1.4;
  }

  .scene :global(.sensor-tip),
  .scene :global(.spin-tip),
  .scene :global(.reading),
  .scene :global(.photon),
  .scene :global(.bar),
  .scene :global(.plume circle) {
    fill: var(--color-glacier);
  }

  .scene :global(.cloud) {
    fill: var(--color-glacier);
    stroke: rgb(110 231 249 / 0.22);
    stroke-width: 9;
  }

  .scene :global(.ping) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 1.2;
    opacity: 0.25;
    transform-box: fill-box;
    transform-origin: center;
  }

  .scene :global(.tick),
  .scene :global(.ruler) {
    fill: none;
    stroke: rgb(232 230 225 / 0.5);
    stroke-width: 1.4;
  }

  .scene :global(.err) {
    stroke: rgb(110 231 249 / 0.45);
    stroke-width: 1.4;
  }

  .scene :global(.station) {
    fill: rgb(232 230 225 / 0.72);
  }

  .scene :global(.well),
  .scene :global(.route),
  .scene :global(.signal-cut),
  .scene :global(.connector) {
    fill: none;
    stroke: rgb(232 230 225 / 0.35);
    stroke-width: 1.3;
    stroke-dasharray: 3 6;
  }

  .scene :global(.zone-edge) {
    fill: none;
    stroke: rgb(232 230 225 / 0.35);
    stroke-width: 1.2;
    stroke-dasharray: 5 6;
  }

  .scene :global(.hatch) {
    stroke: rgb(232 230 225 / 0.12);
    stroke-width: 1.2;
  }

  .scene :global(.drift),
  .scene :global(.contact-old),
  .scene :global(.peak-off) {
    fill: none;
    stroke: var(--color-pumice);
    stroke-width: 1.6;
    stroke-dasharray: 6 6;
  }

  .scene :global(.cone) {
    fill: rgb(139 143 152 / 0.09);
  }

  .scene :global(.contact-new) {
    stroke: var(--color-glacier);
    stroke-width: 1.8;
  }

  .scene :global(.baseline),
  .scene :global(.axis) {
    fill: none;
    stroke: rgb(232 230 225 / 0.18);
    stroke-width: 1;
  }

  .scene :global(.axis-soft) {
    stroke: rgb(232 230 225 / 0.18);
    stroke-dasharray: 3 6;
  }

  .scene :global(.bar-hi) {
    fill: rgb(232 230 225 / 0.82);
  }

  .scene :global(.bar-lo) {
    fill: rgb(139 143 152 / 0.38);
  }

  .scene :global(.mc) {
    fill: none;
    stroke: rgb(139 143 152 / 0.26);
    stroke-width: 1;
  }

  .scene :global(.mc-one) {
    fill: none;
    stroke: var(--color-ash);
    stroke-width: 1.6;
  }

  .scene :global(.strike) {
    stroke: rgb(232 230 225 / 0.42);
    stroke-width: 1.2;
    stroke-dasharray: 6 6;
  }

  .scene :global(.est-classical) {
    fill: none;
    stroke: var(--color-pumice);
    stroke-width: 2;
  }

  .scene :global(.est-quantum) {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 2;
  }

  .scene :global(.est-dot) {
    fill: var(--color-pumice);
  }

  .scene :global(.est-dot.q) {
    fill: var(--color-glacier);
  }

  .scene :global(.mesh),
  .scene :global(.grid) {
    stroke: rgb(232 230 225 / 0.06);
    stroke-width: 1;
  }

  .scene :global(.text-dashes path) {
    stroke: var(--color-pumice);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .scene :global(.records path),
  .scene :global(.record) {
    stroke: var(--color-glacier);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .scene :global(.tag) {
    fill: none;
    stroke: rgb(139 143 152 / 0.6);
    stroke-width: 1.2;
  }

  .scene :global(.raw) {
    fill: none;
    stroke: rgb(232 230 225 / 0.55);
    stroke-width: 1.5;
  }

  .scene :global(.sphere) {
    fill: none;
    stroke: rgb(232 230 225 / 0.3);
    stroke-width: 1.3;
  }

  .scene :global(.sphere.dim) {
    stroke: rgb(232 230 225 / 0.15);
  }

  .scene :global(.spin-cone),
  .scene :global(.orbit),
  .scene :global(.entangle) {
    fill: none;
    stroke: rgb(110 231 249 / 0.55);
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
  }

  .scene :global(.spin-vec) {
    stroke: var(--color-glacier);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .scene :global(.spin-origin),
  .scene :global(.nucleus),
  .scene :global(.atom) {
    fill: rgb(232 230 225 / 0.85);
  }

  .scene :global(.atom-spin),
  .scene :global(.coil-line) {
    stroke: var(--color-glacier);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .scene :global(.orbit-small),
  .scene :global(.coil) {
    fill: none;
    stroke: rgb(232 230 225 / 0.4);
    stroke-width: 1.3;
  }

  .scene :global(.comb) {
    stroke: var(--color-glacier);
    stroke-width: 1.8;
  }

  .scene :global(.rotation) {
    fill: none;
    stroke: rgb(232 230 225 / 0.4);
    stroke-width: 1.3;
    stroke-dasharray: 4 6;
  }

  .scene :global(.wire) {
    stroke: rgb(232 230 225 / 0.35);
    stroke-width: 1.3;
  }

  .scene :global(.node-chip) {
    fill: rgb(110 231 249 / 0.2);
    stroke: var(--color-glacier);
    stroke-width: 1.5;
  }

  /* Drones in a simulated twin are drawn as ghosts of the real ones */
  .scene :global(.ghost) {
    opacity: 0.45;
  }

  /* Dots that ride SMIL paths stay hidden until their motion starts */
  .scene :global(.moving) {
    visibility: hidden;
  }

  .scene.is-moving :global(.moving) {
    visibility: visible;
  }

  .scene.is-moving :global(.static-only) {
    visibility: hidden;
  }

  /* ---------- Motion: only when the reader allows it ---------- */

  @keyframes scene-ping {
    from {
      transform: scale(0.4);
      opacity: 0.75;
    }

    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes scene-flow {
    to {
      stroke-dashoffset: -36;
    }
  }

  @keyframes scene-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes scene-fall {
    0% {
      transform: translateY(0);
      opacity: 1;
    }

    80% {
      transform: translateY(360px);
      opacity: 1;
    }

    100% {
      transform: translateY(360px);
      opacity: 0;
    }
  }

  @keyframes scene-sweep {
    0%,
    100% {
      transform: rotate(-2.5deg);
    }

    50% {
      transform: rotate(2.5deg);
    }
  }

  @keyframes scene-grow {
    0% {
      transform: scaleY(0.2);
    }

    55%,
    100% {
      transform: scaleY(1);
    }
  }

  @keyframes scene-jiggle {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-3px);
    }
  }

  .scene.is-animated :global(.ping) {
    animation: scene-ping 3.3s ease-out infinite;
  }

  .scene.is-animated :global(.flow) {
    stroke-dasharray: 12 6;
    animation: scene-flow 1.4s linear infinite;
  }

  .scene.is-animated :global(.precess) {
    animation: scene-spin 3s linear infinite;
  }

  .scene.is-animated :global(.fall) {
    animation: scene-fall 2.6s cubic-bezier(0.55, 0, 1, 0.45) infinite;
  }

  .scene.is-animated :global(.sweep) {
    animation: scene-sweep 6s ease-in-out infinite;
  }

  .scene.is-animated :global(.grow) {
    animation: scene-grow 4.5s var(--ease-out) infinite alternate;
  }

  .scene.is-animated :global(.jiggle) {
    animation: scene-jiggle 1.8s ease-in-out infinite;
  }

  :global(html[data-motion='paused']) .scene :global(*) {
    animation-play-state: paused !important;
  }
</style>
