---
/** The numbered sources at the foot of a topic page. Superscripts link here. */
import type { Source } from '../../content/topics/types';

interface Props {
  list: { n: number; source: Source }[];
}

const { list } = Astro.props;
---

<ol class="sources">
  {
    list.map(({ n, source }) => (
      <li class="source" id={`source-${n}`}>
        <span class="source-n">{n}</span>
        <span class="source-body">
          <a class="source-title" href={source.url} rel="noopener">
            {source.title}
          </a>
          <span class="source-meta">
            {source.publisher}, {source.date}
          </span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .sources {
    display: grid;
    gap: 0 var(--gutter);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 900px) {
    .sources {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .source {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 8px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .source:target {
    background: rgb(110 231 249 / 0.06);
  }

  .source-n {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    padding-top: 2px;
    color: var(--color-glacier);
  }

  .source-body {
    display: grid;
    gap: 4px;
  }

  .source-title {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgb(232 230 225 / 0.88);
    text-decoration: underline;
    text-decoration-color: rgb(232 230 225 / 0.25);
    text-underline-offset: 0.2em;
  }

  .source-title:hover {
    color: var(--color-ash);
    text-decoration-color: var(--color-ash);
  }

  .source-meta {
    font-size: var(--t-micro);
    color: var(--color-pumice);
  }
</style>
