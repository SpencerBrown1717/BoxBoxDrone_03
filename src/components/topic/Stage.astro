---
/**
 * Where a technology stands: an ordinal track from lab to widespread use, with
 * the current stage marked, and the dated milestones behind that judgment.
 */
import type { Milestone } from '../../content/topics/types';
import type { Refs } from '../../lib/cite';
import { stageNames } from '../../content/topics/shared';
import Cite from './Cite.astro';

interface Props {
  level: 0 | 1 | 2 | 3;
  text: string;
  milestones: Milestone[];
  refs: Refs;
}

const { level, text, milestones, refs } = Astro.props;
---

<div class="stage">
  <div class="stage-head">
    <ol class="track" aria-label={`Stage: ${stageNames[level]}`}>
      {
        stageNames.map((name, i) => (
          <li class:list={['track-step', i < level && 'is-past', i === level && 'is-now']} aria-current={i === level ? 'step' : undefined}>
            <span class="track-dot" aria-hidden="true" />
            <span class="track-name">{name}</span>
          </li>
        ))
      }
    </ol>
    <p class="stage-text">{text}</p>
  </div>

  <ol class="milestones">
    {
      milestones.map((m) => (
        <li class="milestone">
          <span class="milestone-year">{m.year}</span>
          <span class="milestone-text">
            {m.text}
            <Cite ids={m.sources} refs={refs} />
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .stage {
    display: grid;
    gap: 48px var(--gutter);
  }

  @media (min-width: 1000px) {
    .stage {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
    }
  }

  .track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .track-step {
    position: relative;
    display: grid;
    gap: 12px;
    padding-top: 2px;
  }

  /* The rail between stages */
  .track-step::before {
    content: '';
    position: absolute;
    left: 7px;
    right: -7px;
    top: 9px;
    height: 2px;
    background: var(--hairline-strong);
  }

  .track-step:last-child::before {
    display: none;
  }

  .track-step.is-past::before {
    background: rgb(110 231 249 / 0.55);
  }

  .track-dot {
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-obsidian);
    border: 2px solid var(--hairline-strong);
  }

  .is-past .track-dot {
    background: rgb(110 231 249 / 0.55);
    border-color: transparent;
  }

  .is-now .track-dot {
    background: var(--color-glacier);
    border-color: var(--color-glacier);
    box-shadow:
      0 0 0 4px var(--color-obsidian),
      0 0 0 5px rgb(110 231 249 / 0.5);
  }

  .track-name {
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--color-pumice);
  }

  .is-now .track-name {
    font-weight: 600;
    color: var(--color-ash);
  }

  .stage-text {
    margin-top: 28px;
    max-width: 46ch;
    font-size: var(--t-lead);
    line-height: 1.55;
    color: rgb(232 230 225 / 0.8);
  }

  .milestones {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .milestone {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .milestone-year {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    padding-top: 2px;
    color: var(--color-glacier);
  }

  .milestone-text {
    font-size: 1rem;
    line-height: 1.55;
    color: rgb(232 230 225 / 0.82);
  }
</style>
