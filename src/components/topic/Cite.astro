---
/** Superscript links to a page's numbered sources. */
import type { Refs } from '../../lib/cite';

interface Props {
  ids?: string[];
  refs: Refs;
}

const { ids = [], refs } = Astro.props;
const numbers = [...new Set(ids.map((id) => refs.get(id)).filter((n): n is number => n !== undefined))].sort((a, b) => a - b);
---

{
  numbers.length > 0 && (
    <sup class="cite">
      {numbers.map((n, i) => (
        <>
          {i > 0 && <span aria-hidden="true">,</span>}
          <a href={`#source-${n}`} aria-label={`Source ${n}`}>
            {n}
          </a>
        </>
      ))}
    </sup>
  )
}

<style>
  .cite {
    margin-left: 0.18em;
    font-family: var(--font-mono);
    font-size: 0.62em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-pumice);
  }

  .cite a {
    color: inherit;
    text-decoration: none;
    padding: 0 0.08em;
  }

  .cite a:hover {
    color: var(--amethyst-hot);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
