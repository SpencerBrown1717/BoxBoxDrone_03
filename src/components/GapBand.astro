---
/**
 * Why America, in three numbers. The sources are on /why-america.
 */
import { gap } from '../content/home';
---

<section class="gap" id={gap.id} aria-labelledby="gap-title">
  <div class="gap-inner">
    <p class="gap-eyebrow">{gap.eyebrow}</p>
    <h2 class="gap-title" id="gap-title">{gap.headline}</h2>
    <p class="gap-support">{gap.support}</p>
    <dl class="gap-facts">
      {
        gap.facts.map((fact) => (
          <div class="gap-fact">
            <dt>{fact.value}</dt>
            <dd>{fact.label}</dd>
          </div>
        ))
      }
    </dl>
    <a class="gap-link text-link" href={gap.link.href}>{gap.link.label}</a>
  </div>
</section>

<style>
  .gap {
    padding-block: clamp(96px, 14svh, 176px);
    background: var(--color-obsidian);
    border-top: 1px solid var(--hairline);
  }

  .gap-inner {
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--margin);
  }

  .gap-eyebrow {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-amber);
  }

  .gap-title {
    margin-top: 14px;
    font-size: var(--t-display);
    max-width: 11em;
  }

  .gap-support {
    margin-top: 20px;
    max-width: 40ch;
    font-size: var(--t-lead);
    color: rgb(232 230 225 / 0.78);
  }

  .gap-facts {
    display: grid;
    gap: 36px var(--gutter);
    margin: 64px 0 0;
  }

  @media (min-width: 760px) {
    .gap-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gap-fact {
    padding-top: 22px;
    border-top: 1px solid var(--hairline-strong);
  }

  .gap-fact dt {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(2.5rem, 1.9rem + 2.4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-ash);
  }

  .gap-fact dd {
    margin: 14px 0 0;
    max-width: 30ch;
    font-size: 1rem;
    line-height: 1.5;
    color: rgb(232 230 225 / 0.72);
  }

  .gap-link {
    display: inline-block;
    margin-top: 40px;
    font-size: 1rem;
    font-weight: 500;
  }
</style>
