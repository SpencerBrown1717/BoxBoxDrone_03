---
/**
 * Hero artwork for the lit layer: delivery routes rising from a hub on the
 * ground line, drawn in the iridescent edge of the glass. Decorative and
 * aria-hidden, kept faint so every line of copy above it keeps its contrast.
 */
// Routes stay in the band under the copy and the scale, so no line crosses a word.
const routes = [
  { from: [150, 860], c: [560, 700], to: [1560, 720] },
  { from: [150, 860], c: [700, 770], to: [1300, 790] },
  { from: [150, 860], c: [900, 800], to: [1580, 830] },
  { from: [150, 860], c: [420, 760], to: [980, 740] },
];

const point = (r: (typeof routes)[number], t: number) => {
  const u = 1 - t;
  return [
    u * u * r.from[0] + 2 * u * t * r.c[0] + t * t * r.to[0],
    u * u * r.from[1] + 2 * u * t * r.c[1] + t * t * r.to[1],
  ];
};

const drones = [
  point(routes[0], 0.78),
  point(routes[1], 0.66),
  point(routes[3], 0.94),
];

const f = (n: number) => n.toFixed(1);
---

<svg class="routes" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="route-edge" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" class="stop-violet" />
      <stop offset="0.45" class="stop-cyan" />
      <stop offset="1" class="stop-amber" />
    </linearGradient>
  </defs>
  {
    routes.map((r) => (
      <path class="route" d={`M${r.from[0]} ${r.from[1]}Q${r.c[0]} ${r.c[1]} ${r.to[0]} ${r.to[1]}`} />
    ))
  }
  {
    drones.map(([x, y]) => (
      <g class="drone" transform={`translate(${f(x)} ${f(y)})`}>
        <path d="M-9 -9L9 9M9 -9L-9 9" />
        <circle cx="-9" cy="-9" r="5" />
        <circle cx="9" cy="-9" r="5" />
        <circle cx="-9" cy="9" r="5" />
        <circle cx="9" cy="9" r="5" />
        <rect class="body" x="-3.5" y="-3.5" width="7" height="7" rx="1.5" />
      </g>
    ))
  }
  <g class="hub" transform="translate(150 860)">
    <rect x="-16" y="-16" width="32" height="32" rx="3" />
    <rect x="-7" y="-7" width="14" height="14" rx="1" />
  </g>
</svg>

<style>
  .routes {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .stop-violet {
    stop-color: var(--iris-violet);
  }

  .stop-cyan {
    stop-color: var(--iris-cyan);
  }

  .stop-amber {
    stop-color: var(--iris-amber);
  }

  .route {
    fill: none;
    stroke: url(#route-edge);
    stroke-width: 1.4;
    stroke-dasharray: 2 7;
    stroke-linecap: round;
    opacity: 0.5;
  }

  .drone path,
  .drone circle {
    fill: none;
    stroke: var(--color-glacier);
    stroke-width: 1.3;
    opacity: 0.55;
  }

  .drone .body {
    fill: var(--color-ash);
    opacity: 0.7;
  }

  .hub rect {
    fill: none;
    stroke: var(--color-ash);
    stroke-width: 1.3;
    opacity: 0.4;
  }

  @media (prefers-reduced-motion: no-preference) {
    .route {
      animation: route-flow 2.4s linear 6;
    }
  }

  :global([data-motion='paused']) .route {
    animation-play-state: paused;
  }

  @keyframes route-flow {
    to {
      stroke-dashoffset: -36;
    }
  }

  @media (max-width: 899px) {
    .routes {
      opacity: 0.6;
    }
  }
</style>
