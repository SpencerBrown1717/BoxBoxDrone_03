---
/**
 * The BBD mark: a quadcopter seen from above, carrying a box. Four rotor rings,
 * four short arms and the box at its center. White on black; uses currentColor
 * so it follows the text color around it. The same geometry is in
 * scripts/make-assets.mjs and public/logo.
 */
import { markPaths } from '../lib/mark';

interface Props {
  size?: number;
  class?: string;
  label?: string;
}

const { size = 18, class: className, label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 72 72"
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {markPaths.map((d) => <path d={d} fill-rule="evenodd" />)}
</svg>
