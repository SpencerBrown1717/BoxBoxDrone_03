---
/**
 * The BBD mark: a drone seen from above. A square body (the box), four arms
 * and four rotors. White on black; uses currentColor so it follows the text
 * color around it. The same paths feed scripts/make-assets.mjs.
 */
interface Props {
  size?: number;
  class?: string;
  label?: string;
}

const { size = 18, class: className, label } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 72 72"
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path
    fill-rule="evenodd"
    d="M3 14a11 11 0 1 0 22 0a11 11 0 1 0 -22 0ZM7.5 14a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0ZM47 14a11 11 0 1 0 22 0a11 11 0 1 0 -22 0ZM51.5 14a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0ZM3 58a11 11 0 1 0 22 0a11 11 0 1 0 -22 0ZM7.5 58a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0ZM47 58a11 11 0 1 0 22 0a11 11 0 1 0 -22 0ZM51.5 58a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0Z"
  ></path>
  <path
    d="M29 25H43A4 4 0 0 1 47 29V43A4 4 0 0 1 43 47H29A4 4 0 0 1 25 43V29A4 4 0 0 1 29 25ZM18.3 21.7 21.7 18.3 28.7 25.3 25.3 28.7ZM53.7 21.7 50.3 18.3 43.3 25.3 46.7 28.7ZM18.3 50.3 21.7 53.7 28.7 46.7 25.3 43.3ZM53.7 50.3 50.3 53.7 43.3 46.7 46.7 43.3Z"
  ></path>
</svg>
