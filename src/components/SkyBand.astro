---
/**
 * The live sky as a full-bleed band, for inner page heroes.
 * Hidden from assistive technology; the page tells the same story in text.
 */
import type { SkyScene } from '../scripts/sky';

interface Props {
  scenes: SkyScene[];
  interval?: number;
  ground?: number;
  caption?: string;
}

const { scenes, interval = 8000, ground = 0.86, caption } = Astro.props;
---

<figure class="band" data-sky-band data-scenes={scenes.join(',')} data-interval={interval} data-ground={ground}>
  <canvas aria-hidden="true"></canvas>
  {caption && <figcaption class="visually-hidden">{caption}</figcaption>}
  <button class="band-toggle button button--secondary button--sm" type="button" data-motion-toggle hidden>Pause motion</button>
</figure>

<script>
  import { mountBands } from '../scripts/band';
  mountBands();
</script>

<style>
  .band {
    position: relative;
    height: clamp(360px, 60svh, 660px);
    margin: 0;
    border-block: 1px solid var(--hairline);
    background: var(--color-obsidian);
    overflow: hidden;
  }

  .band canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .band-toggle {
    position: absolute;
    right: var(--margin);
    bottom: 12px;
  }

  .band-toggle[hidden] {
    display: none;
  }
</style>
