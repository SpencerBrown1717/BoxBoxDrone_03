---
/**
 * After the story: why now. America is behind in drones, and how BBD plans to
 * win on software. Each fact links to its source.
 */
import { america } from '../content/home';
import { sources } from '../content/topics/sources';
---

<section class="america" id={america.id} aria-labelledby="america-title">
  <div class="frame">
    <div class="head">
      <p class="eyebrow">{america.eyebrow}</p>
      <h2 class="title" id="america-title">{america.headline}</h2>
      <p class="support">{america.support}</p>
    </div>

    <dl class="facts">
      {
        america.facts.map((fact) => {
          const source = sources[fact.source];
          return (
            <div class="fact">
              <dt class="fact-value">{fact.value}</dt>
              <dd class="fact-label">
                {fact.label}
                <a class="fact-source" href={source.url} rel="noopener">
                  {source.publisher}, {source.date}
                </a>
              </dd>
            </div>
          );
        })
      }
    </dl>

    <ol class="pillars" aria-label="How we win">
      {
        america.pillars.map((pillar, i) => (
          <li class="pillar">
            <span class="pillar-n" aria-hidden="true">
              0{i + 1}
            </span>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-text">{pillar.text}</p>
          </li>
        ))
      }
    </ol>

    <a class="more text-link" href={america.link.href}>{america.link.label}</a>
  </div>
</section>

<style>
  .america {
    position: relative;
    padding-block: clamp(112px, 16svh, 200px) clamp(96px, 12svh, 160px);
    background: var(--color-obsidian);
    border-top: 1px solid var(--hairline);
  }

  .eyebrow {
    margin-bottom: 14px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-amber);
  }

  .title {
    font-size: var(--t-display);
    max-width: 10em;
  }

  .support {
    margin-top: 22px;
    max-width: 44ch;
    font-size: var(--t-lead);
    color: rgb(232 230 225 / 0.8);
  }

  .facts {
    display: grid;
    gap: 36px var(--gutter);
    margin: clamp(56px, 7vw, 88px) 0 0;
    padding-top: 36px;
    border-top: 1px solid var(--hairline-strong);
  }

  @media (min-width: 760px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .fact-value {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 1.9rem + 2.2vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ash);
  }

  .fact-label {
    margin: 14px 0 0;
    max-width: 30ch;
    font-size: var(--t-body);
    color: rgb(232 230 225 / 0.78);
  }

  .fact-source {
    display: block;
    margin-top: 10px;
    font-size: var(--t-small);
    color: var(--color-pumice);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: rgb(139 143 152 / 0.45);
  }

  .fact-source:hover {
    color: var(--color-ash);
  }

  .pillars {
    display: grid;
    gap: 32px var(--gutter);
    margin: clamp(64px, 8vw, 104px) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pillar {
    padding: 28px;
    background: var(--glass), var(--color-graphite);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-surface);
  }

  .pillar-n {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--color-glacier);
  }

  .pillar-title {
    margin-top: 14px;
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.25rem);
  }

  .pillar-text {
    margin-top: 10px;
    font-size: var(--t-body);
    color: rgb(232 230 225 / 0.8);
  }

  .more {
    display: inline-block;
    margin-top: 40px;
    font-weight: 500;
  }
</style>
